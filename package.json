    "@types/express": "^5.0.6",
    "@types/node": "^25.9.8",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
