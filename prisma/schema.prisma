generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "restaurant"]
}

// ─────────────────────────────────────────────
// Schema: public — CRM / gestión de clientes
// ─────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING

  @@schema("public")
}

enum BillingFrequency {
  MONTHLY
  ANNUAL

  @@schema("public")
}

/// Cliente registrado en el sistema
model User {
  id        String     @id @default(uuid())
  dni       String     @unique
  name      String
  email     String     @unique
  company   String     @default("")
  phone     String     @default("")
  address   String     @default("")
  domains   String[]   @default([])
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  instances   Instance[]
  sessions    Session[]
  credentials Credential[]

  @@map("users")
  @@schema("public")
}

/// Credencial de acceso al portal — un cliente puede tener una o varias,
/// cada una con su propio nombre, usuario y contraseña (p. ej. camareros).
model Credential {
  id        String   @id @default(uuid())
  userId    String
  name      String   @default("")
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("credentials")
  @@schema("public")
}

/// Sesión (token expirable). Para sesiones de cliente (customer portal),
/// además del `userId` (la cuenta/restaurante) guarda qué `Credential`
/// concreta inició sesión — es decir, qué camarero/a es — para que el
/// backend sepa siempre "quién" hizo cada acción sin depender del body.
model Session {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String?
  credentialId String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@map("sessions")
  @@schema("public")
}

/// Tipo de aplicación disponible en el catálogo (ej: Restaurante)
model Application {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String @default("text-indigo-400")
  icon  String @default("default")

  services  Service[]
  instances Instance[]

  @@map("applications")
  @@schema("public")
}

/// Servicio concreto que pertenece a una aplicación (ej: Reservas online)
model Service {
  id            Int    @id @default(autoincrement())
  applicationId Int
  name          String
  description   String @default("")
  price         String @default("")

  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  instanceServices InstanceService[]

  @@map("services")
  @@schema("public")
}

/// Contratación de una aplicación por parte de un cliente
model Instance {
  id              Int       @id @default(autoincrement())
  userId          String
  applicationId   Int
  contractDate    DateTime  @default(now())
  lastPaymentDate DateTime?
  createdAt       DateTime  @default(now())

  // Facturación: cada cuánto se cobra, desde qué fecha y qué día del ciclo
  // (mensual = día del mes; anual = mismo día/mes que billingStartDate).
  // Si billingStartDate es null se usa contractDate como fecha de inicio.
  billingFrequency BillingFrequency @default(MONTHLY)
  billingStartDate DateTime?
  billingDay       Int              @default(1)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  instanceServices InstanceService[]
  payments         Payment[]
  menus            Menu[]
  menuSections     MenuSection[]
  reservations     Reservation[]
  orders           Order[]

  @@unique([userId, applicationId])
  @@map("instances")
  @@schema("public")
}

/// Registro histórico de un pago realizado por un cliente para una instancia contratada
model Payment {
  id         Int      @id @default(autoincrement())
  instanceId Int
  paidAt     DateTime @default(now())
  note       String   @default("")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@schema("public")
}

/// Servicio activo/inactivo para un contrato concreto (Instance ↔ Service)
model InstanceService {
  id            Int     @id @default(autoincrement())
  instanceId    Int
  serviceId     Int
  active        Boolean @default(true)
  priceOverride String  @default("") // precio personalizado para este cliente, vacío = usa el del catálogo

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, serviceId])
  @@map("instance_services")
  @@schema("public")
}

// ─────────────────────────────────────────────
// Schema: restaurant — Menú digital, reservas y comandas
// ─────────────────────────────────────────────

enum Allergen {
  GLUTEN
  CRUSTACEOS
  HUEVOS
  PESCADO
  CACAHUETES
  SOJA
  LACTEOS
  FRUTOS_DE_CASCARA
  APIO
  MOSTAZA
  SESAMO
  SULFITOS
  ALTRAMUCES
  MOLUSCOS

  @@schema("restaurant")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@schema("restaurant")
}

enum OrderStatus {
  PENDING // Recibido, aún no ha entrado en cocina
  IN_PROGRESS // En preparación en cocina
  READY // Listo para servir/recoger
  DELIVERED // Entregado en mesa / cerrado
  CANCELLED

  @@schema("restaurant")
}

/// Carta/menú de un restaurante (pertenece a una instancia de la app Restaurante)
model Menu {
  id         Int      @id @default(autoincrement())
  instanceId Int
  name       String
  createdAt  DateTime @default(now())

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  dishes   Dish[]

  @@map("menus")
  @@schema("restaurant")
}

/// Sección de la carta (Entrante, Principal, Postre...) de un restaurante.
/// Es una lista propia por restaurante (no un enum global) para poder
/// crear, renombrar, reordenar o eliminar secciones libremente. Al crear
/// una instancia de Restaurante se siembra con el set por defecto
/// (Entrante, Principal, Postre, Bebida, Guarnición, Tapa, Menú cerrado).
model MenuSection {
  id         Int      @id @default(autoincrement())
  instanceId Int
  name       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, name])
  @@map("menu_sections")
  @@schema("restaurant")
}

/// Plato individual dentro de un menú
model Dish {
  id          Int    @id @default(autoincrement())
  menuId      Int
  name        String
  description String @default("")
  price       String @default("")

  // Texto libre en vez de enum: permite crear secciones nuevas de carta
  // ("Especiales", "Cumpleaños"...) sin necesitar tocar el esquema.
  category  String     @default("Principal")
  allergens Allergen[] @default([])

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@map("dishes")
  @@schema("restaurant")
}

/// Reserva de un cliente en un restaurante
model Reservation {
  id              Int               @id @default(autoincrement())
  instanceId      Int
  customerName    String
  customerPhone   String
  customerEmail   String            @default("")
  reservationDate DateTime
  guests          Int
  notes           String            @default("")
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("reservations")
  @@schema("restaurant")
}

/// Pedido de un cliente en una mesa del restaurante (comanda)
model Order {
  id          Int         @id @default(autoincrement())
  instanceId  Int
  tableNumber Int
  waiterName  String
  status      OrderStatus @default(PENDING)
  notes       String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  instance Instance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@map("orders")
  @@schema("restaurant")
}

/// Línea de un pedido — guarda una "foto" del nombre y precio del plato en
/// el momento de crear el pedido, para que el histórico no cambie si luego
/// se edita o elimina el plato en la carta.
model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  dishName  String
  quantity  Int
  unitPrice Float @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
  @@schema("restaurant")
}
