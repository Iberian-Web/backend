generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "restaurant"]
}

// ─────────────────────────────────────────────
// Schema: public — CRM / gestión de clientes
// ─────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING

  @@schema("public")
}

enum BillingFrequency {
  MONTHLY
  ANNUAL

  @@schema("public")
}

/// CONTRACT = contrato de prestación de servicios (legal, vinculante).
/// WEB_SCOPE = ficha descriptiva de lo que incluye el proyecto web (más
/// detallada y comercial que el Anexo I del contrato).
/// MAINTENANCE_PLAN = ficha del servicio de mantenimiento recurrente: qué
/// cubre, qué no, tiempos de respuesta y cuota.
/// QUOTE = presupuesto previo a la contratación con el desglose de precios.
/// RENEWAL = addendum que prorroga un CONTRACT ya existente para un nuevo
/// periodo, actualizando condiciones económicas si procede. Requiere que ya
/// exista al menos un documento CONTRACT para ese cliente.
enum DocumentType {
  CONTRACT
  WEB_SCOPE
  MAINTENANCE_PLAN
  QUOTE
  RENEWAL

  @@schema("public")
}

/// ACTIVE = "vigente" (la última generada). Al generar un documento nuevo del
/// mismo tipo, el anterior pasa automáticamente a SUPERSEDED — nunca se borra,
/// así queda el histórico de qué condiciones aceptó el cliente y cuándo.
enum DocumentStatus {
  ACTIVE
  SUPERSEDED

  @@schema("public")
}

/// Cliente registrado en el sistema
model User {
  id        String     @id @default(uuid())
  dni       String     @unique
  name      String
  email     String     @unique
  company   String     @default("")
  phone     String     @default("")
  address   String     @default("")
  domains   String[]   @default([])
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  instances   Instance[]
  sessions    Session[]
  credentials Credential[]
  documents   Document[]

  @@map("users")
  @@schema("public")
}

/// Documento generado para un cliente (contrato, ficha de alcance web, ficha
/// de mantenimiento o presupuesto — todos en PDF). El PDF se guarda en la
/// propia fila (`data`) para no depender de un almacenamiento de ficheros
/// aparte; `select` sin `data` en los listados evita cargar los bytes salvo
/// que se pida la descarga concreta.
model Document {
  id             Int            @id @default(autoincrement())
  userId         String
  type           DocumentType   @default(CONTRACT)
  status         DocumentStatus @default(ACTIVE)
  fileName       String
  setupFee       String         @default("")
  maintenanceFee String         @default("")
  notes          String         @default("")
  data           Bytes
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("documents")
  @@schema("public")
}

/// Credencial de acceso al portal — un cliente puede tener una o varias,
/// cada una con su propio nombre, usuario y contraseña (p. ej. camareros).
model Credential {
  id        String   @id @default(uuid())
  userId    String
  name      String   @default("")
  username  String   @unique
  password  String
  role      String   @default("") // etiqueta libre: "Camarero", "Cocina", "Encargado"...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions           Session[]
  credentialServices CredentialService[]

  @@index([userId])
  @@map("credentials")
  @@schema("public")
}

/// Sesión (token expirable). Para sesiones de cliente (customer portal),
/// además del `userId` (la cuenta/restaurante) guarda qué `Credential`
/// concreta inició sesión — es decir, qué camarero/a es — para que el
/// backend sepa siempre "quién" hizo cada acción sin depender del body.
model Session {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String?
  credentialId String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([credentialId])
  @@map("sessions")
  @@schema("public")
}

/// Tipo de aplicación disponible en el catálogo (ej: Restaurante)
model Application {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String @default("text-indigo-400")
  icon  String @default("default")

  services  Service[]
  instances Instance[]

  @@map("applications")
  @@schema("public")
}

/// Servicio concreto que pertenece a una aplicación (ej: Reservas online)
model Service {
  id            Int    @id @default(autoincrement())
  applicationId Int
  name          String
  description   String @default("")
  price         String @default("")

  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  instanceServices InstanceService[]
  credentialServices CredentialService[]

  @@index([applicationId])
  @@map("services")
  @@schema("public")
}

/// Contratación de una aplicación por parte de un cliente
model Instance {
  id              Int       @id @default(autoincrement())
  userId          String
  applicationId   Int
  contractDate    DateTime  @default(now())
  lastPaymentDate DateTime?
  createdAt       DateTime  @default(now())

  // Facturación: cada cuánto se cobra, desde qué fecha y qué día del ciclo
  // (mensual = día del mes; anual = mismo día/mes que billingStartDate).
  // Si billingStartDate es null se usa contractDate como fecha de inicio.
  billingFrequency BillingFrequency @default(MONTHLY)
  billingStartDate DateTime?
  billingDay       Int              @default(1)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  instanceServices InstanceService[]
  payments         Payment[]
  menus            Menu[]
  menuSections     MenuSection[]
  reservations     Reservation[]
  orders           Order[]
  tableSessions    TableSession[]
  restaurantTables RestaurantTable[]
  auditLogs        AuditLog[]

  @@unique([userId, applicationId])
  @@index([applicationId])
  @@map("instances")
  @@schema("public")
}

/// Registro histórico de un pago realizado por un cliente para una instancia contratada
model Payment {
  id         Int      @id @default(autoincrement())
  instanceId Int
  paidAt     DateTime @default(now())
  note       String   @default("")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("payments")
  @@schema("public")
}

/// Servicio activo/inactivo para un contrato concreto (Instance ↔ Service)
model InstanceService {
  id            Int     @id @default(autoincrement())
  instanceId    Int
  serviceId     Int
  active        Boolean @default(true)
  priceOverride String  @default("") // precio personalizado para este cliente, vacío = usa el del catálogo

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, serviceId])
  @@index([serviceId])
  @@map("instance_services")
  @@schema("public")
}

/// Habilita/deshabilita un servicio (ya activo a nivel de contrato) para una
/// credencial (usuario) concreta — p. ej. ocultarle "Cocina" a un camarero.
/// Sin fila = habilitado (opt-out): así una credencial nueva ve todo lo que
/// su contrato tiene activo, sin necesitar sembrar filas por cada servicio.
model CredentialService {
  id           Int     @id @default(autoincrement())
  credentialId String
  serviceId    Int
  enabled      Boolean @default(true)

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([credentialId, serviceId])
  @@index([serviceId])
  @@map("credential_services")
  @@schema("public")
}

// ─────────────────────────────────────────────
// Schema: restaurant — Menú digital, reservas y comandas
// ─────────────────────────────────────────────

enum Allergen {
  GLUTEN
  CRUSTACEOS
  HUEVOS
  PESCADO
  CACAHUETES
  SOJA
  LACTEOS
  FRUTOS_DE_CASCARA
  APIO
  MOSTAZA
  SESAMO
  SULFITOS
  ALTRAMUCES
  MOLUSCOS

  @@schema("restaurant")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@schema("restaurant")
}

/// Acción registrada en el histórico de auditoría (ver `AuditLog`). Cubre las
/// operaciones destructivas o irreversibles del portal: quién cerró, canceló
/// o eliminó qué y cuándo, para poder responder "¿qué pasó con la mesa 7
/// anoche?" sin depender de la memoria de nadie.
enum AuditAction {
  ORDER_CANCELLED
  ORDER_DELETED
  TABLE_SESSION_CLOSED
  TABLE_DELETED

  @@schema("restaurant")
}

enum OrderStatus {
  PENDING // Legado: pedidos creados antes de que todo pedido nuevo entrase
  // directamente en cocina. ya no se asigna a pedidos nuevos.
  IN_PROGRESS // En cocina (estado inicial de cualquier pedido nuevo)
  READY // Listo para servir/recoger
  DELIVERED // Entregado en mesa / cerrado
  CANCELLED

  @@schema("restaurant")
}

/// Carta/menú de un restaurante (pertenece a una instancia de la app Restaurante)
model Menu {
  id         Int      @id @default(autoincrement())
  instanceId Int
  name       String
  createdAt  DateTime @default(now())

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  dishes   Dish[]

  @@index([instanceId])
  @@map("menus")
  @@schema("restaurant")
}

/// Sección de la carta (Entrante, Principal, Postre...) de un restaurante.
/// Es una lista propia por restaurante (no un enum global) para poder
/// crear, renombrar, reordenar o eliminar secciones libremente. Al crear
/// una instancia de Restaurante se siembra con el set por defecto
/// (Entrante, Principal, Postre, Bebida, Guarnición, Tapa, Menú cerrado).
model MenuSection {
  id         Int      @id @default(autoincrement())
  instanceId Int
  name       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, name])
  @@map("menu_sections")
  @@schema("restaurant")
}

/// Plato individual dentro de un menú
model Dish {
  id          Int    @id @default(autoincrement())
  menuId      Int
  name        String
  description String @default("")
  price       String @default("")

  // Texto libre en vez de enum: permite crear secciones nuevas de carta
  // ("Especiales", "Cumpleaños"...) sin necesitar tocar el esquema.
  category  String     @default("Principal")
  allergens Allergen[] @default([])

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
  @@map("dishes")
  @@schema("restaurant")
}

enum TableShape {
  RECTANGLE
  ROUND

  @@schema("restaurant")
}

/// Reserva de un cliente en un restaurante
model Reservation {
  id              Int               @id @default(autoincrement())
  instanceId      Int
  customerName    String
  customerPhone   String
  customerEmail   String            @default("")
  reservationDate DateTime
  guests          Int
  notes           String            @default("")
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("reservations")
  @@schema("restaurant")
}

/// Mesa física del salón, colocada en el mapa de mesas (página "Mapa" del
/// portal). `posRow`/`posCol` son las coordenadas (fila/columna, empezando
/// en 0) de la celda superior-izquierda que ocupa dentro de la rejilla del
/// mapa; `width`/`height` cuántas celdas ocupa en cada dirección (mesas
/// grandes o uniones de mesas). Es un elemento puramente visual/organizativo:
/// no participa en las relaciones de Order/TableSession, que siguen
/// identificando la mesa solo por su número (`tableNumber`) — así el mapa se
/// puede activar en un restaurante que ya tenga pedidos históricos sin
/// migrar nada.
model RestaurantTable {
  id         Int        @id @default(autoincrement())
  instanceId Int
  number     Int
  name       String     @default("")
  seats      Int        @default(2)
  shape      TableShape @default(RECTANGLE)
  posRow     Int        @default(0)
  posCol     Int        @default(0)
  width      Int        @default(1)
  height     Int        @default(1)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, number])
  @@index([instanceId])
  @@map("restaurant_tables")
  @@schema("restaurant")
}

/// "Sentada" de una mesa: agrupa todos los pedidos hechos por los mismos
/// comensales mientras están en la mesa. Se abre automáticamente con el
/// primer pedido de esa mesa y sigue abierta mientras se van añadiendo
/// pedidos nuevos ("Nuevo pedido para esta mesa" reutiliza la sesión
/// abierta en vez de crear una desconectada); se cierra explícitamente al
/// cobrar ("Cerrar mesa"), lo que permite imprimir un único ticket con
/// todo lo consumido (comida + postre + lo que sea) en vez de solo el
/// último pedido.
model TableSession {
  id          Int       @id @default(autoincrement())
  instanceId  Int
  tableNumber Int
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([instanceId])
  @@map("table_sessions")
  @@schema("restaurant")
}

/// Pedido de un cliente en una mesa del restaurante (comanda)
model Order {
  id             Int         @id @default(autoincrement())
  instanceId     Int
  tableSessionId Int
  tableNumber    Int
  waiterName     String
  status         OrderStatus @default(IN_PROGRESS)
  notes          String      @default("")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  instance     Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@index([instanceId])
  @@index([tableSessionId])
  @@map("orders")
  @@schema("restaurant")
}

/// Línea de un pedido — guarda una "foto" del nombre y precio del plato en
/// el momento de crear el pedido, para que el histórico no cambie si luego
/// se edita o elimina el plato en la carta.
model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  dishName  String
  quantity  Int
  unitPrice Float @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
  @@schema("restaurant")
}

/// Histórico de operaciones irreversibles (cancelar/eliminar un pedido,
/// cerrar una mesa, eliminar una mesa del mapa): quién lo hizo, cuándo y un
/// resumen legible de qué era, para poder responder después "¿qué pasó con
/// la mesa 7 anoche?" sin haber tenido que evitar el borrado físico en sí.
/// No se puede editar ni eliminar desde la API — solo se crea.
model AuditLog {
  id         Int         @id @default(autoincrement())
  instanceId Int
  action     AuditAction
  actorName  String      @default("") // camarero/a (o "Cliente") resuelto desde la sesión, nunca del body
  tableNumber Int?
  summary    String      @default("") // texto libre: p.ej. "3 líneas · 42,50 €"
  createdAt  DateTime    @default(now())

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, createdAt])
  @@map("audit_logs")
  @@schema("restaurant")
}
